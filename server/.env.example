# MantraSkill Server Environment Variables

# Koneksi Database PostgreSQL (e.g. Neon.tech)
DATABASE_URL=postgresql://user:password@hostname/dbname?sslmode=require

# Google Gemini API Key (dari AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Secret Key untuk JWT Authentication (pilih string random panjang)
JWT_SECRET=your_jwt_secret_random_string_here

# Port Server (Default: 5001)
PORT=5001
